[Unit]
Description=AEGIS Infrastructure Security Telemetry Agent
After=network.target mysqld.service sshd.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aegis-agent
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /opt/aegis-agent/aegis_agent.py
Restart=always
RestartSec=5
TimeoutStopSec=5
KillSignal=SIGTERM
Nice=19
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
